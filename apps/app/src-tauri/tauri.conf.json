{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kayospace",
  "version": "0.11.0",
  "identifier": "app.kayospace.workspace",
  "build": {
    "beforeDevCommand": "node ../../scripts/dev.mjs",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter @kayospace/workspace build",
    "frontendDist": "../../workspace/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kayospace",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["kayospace"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["kayospace"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDQkY0MTJEMzYwNkY4QjEKUldTeCtBWTJMVUcvRE1jZU4rLzkyd09LcXV6SlF1M2dyUmUyR2VvdlQzMXRRQS93U3VlUnMzTk8K",
      "endpoints": ["https://github.com/Kayosac/KayoSpace/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
