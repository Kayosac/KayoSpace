{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kayospace",
  "version": "0.2.0",
  "identifier": "app.kayospace.workspace",
  "build": {
    "beforeDevCommand": "pnpm --filter @kayospace/pen-lab dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @kayospace/pen-lab build",
    "frontendDist": "../../pen-lab/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kayospace",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
