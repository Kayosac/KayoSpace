{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Базовые права главного окна: события, ссылки kayospace://, секреты устройства, сохранение экспорта, ссылки на релизы",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    "secure-store:default",
    "share-target:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/Kayosac/KayoSpace/*"
        },
        {
          "url": "https://claude.ai/*"
        }
      ]
    }
  ]
}
