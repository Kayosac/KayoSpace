# Скопируйте в deploy/.env (или запустите setup.sh — он создаст файл сам).

# Домен хаба. Без своего домена подойдёт sslip.io: IP 203.0.113.5 → 203-0-113-5.sslip.io
HUB_DOMAIN=203-0-113-5.sslip.io

# Токен доступа: openssl rand -hex 24
HUB_TOKEN=замените-на-случайную-строку

# --- ИИ в доске (кнопка «✦ ИИ»), по желанию ---
# Включить исполнителя ИИ на сервере:
# COMPOSE_PROFILES=ai
# Токен подписки Claude: на своём компьютере выполните `claude setup-token` и вставьте строку сюда.
# CLAUDE_CODE_OAUTH_TOKEN=
# Модель: sonnet (по умолчанию) или opus.
# CLAUDE_MODEL=sonnet

# Лимиты памяти контейнеров (по умолчанию хаб 768m, исполнитель ИИ 1g).
# HUB_MEMORY=768m
# AI_WORKER_MEMORY=1g
