# Caddy сам получает и продлевает сертификат Let's Encrypt для HUB_DOMAIN.
# Сертификат выдаётся через порт 80 (HTTP-01), поэтому HTTPS может жить на любом порту:
# если 443 занят (например, VPN), setup.sh выбирает HTTPS_PORT=8443.
{
	https_port {$HTTPS_PORT:443}
	# Только HTTP/1.1: браузеры открывают WebSocket поверх HTTP/2 (RFC 8441), и этот путь через прокси
	# оказался ненадёжным. Трафику хаба HTTP/2 ничего не даёт.
	servers {
		protocols h1
	}
}

{$HUB_DOMAIN} {
	header -Server
	# Без сжатия и без буферизации: синхронизация (WebSocket, в том числе поверх HTTP/2) и MCP
	# (потоковые ответы) шлют маленькие сообщения, которые должны уходить сразу.
	reverse_proxy hub:4000 {
		flush_interval -1
	}
}
